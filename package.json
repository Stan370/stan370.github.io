    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "katex": "^0.19.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2",
