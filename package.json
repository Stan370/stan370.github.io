{
  "name": "stanblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "check": "astro check",
    "lint": "astro check",
    "test": "npx --yes tsx --test src/i18n/utils.test.ts src/lib/content-i18n.test.ts scripts/lib/md-ast.test.mjs",
    "translate": "node scripts/translate.mjs",
    "translate:dry": "node scripts/translate.mjs --dry-run",
    "build": "astro check && astro build && npm run postbuild:search && node scripts/check-urls.mjs",
    "postbuild:search": "pagefind --site dist --include-characters \"+#\"",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "start": "astro preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@google/genai": "^3.6.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.4.1",
    "astro-expressive-code": "^0.44.3",
    "katex": "^0.19.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/sanitize-html": "^2.16.2",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
