{
  "name": "stanblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && npm run postbuild:search && node scripts/check-urls.mjs",
    "postbuild:search": "pagefind --site dist --force-language zh --include-characters \"+#\"",
    "preview": "astro preview"
  },
