---
import TermPage from '../../components/TermPage.astro';
import { getPosts, taxonomy, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  return taxonomy(await getPosts(), 'categories').map(([term, { name, posts }]) => ({
    params: { term },
    props: { name, posts },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<TermPage kind="categories" name={name} posts={posts} />
