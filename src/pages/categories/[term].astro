---
import TermPage from '../../components/TermPage.astro';
import { getTermStaticPaths } from '../../lib/routes';
import type { Post } from '../../lib/posts';

export const getStaticPaths = () => getTermStaticPaths('zh', 'categories');

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<TermPage kind="categories" locale="zh" name={name} posts={posts} />
