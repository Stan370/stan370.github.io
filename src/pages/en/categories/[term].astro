---
import TermPage from '../../../components/TermPage.astro';
import { getTermStaticPaths } from '../../../lib/routes';
import type { Post } from '../../../lib/posts';

export const getStaticPaths = () => getTermStaticPaths('en', 'categories');

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<TermPage kind="categories" locale="en" name={name} posts={posts} />
