---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif/latin-400.css';
import 'lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import latinSerif from '@fontsource/noto-serif-sc/files/noto-serif-sc-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import {
  getAlternateLinks,
  getAlternateLocale,
  getLocaleFromPath,
  getLocaleMeta,
  useTranslations,
} from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import { site } from '../site.config';

export interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
  locale?: Locale;
  lang?: string;
  type?: 'website' | 'article';
  /** Site-relative path to the social card image. */
  image?: string;
  published?: Date;
  modified?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Emit bidirectional hreflang alternate links (disabled automatically on noindex pages). */
  emitHreflang?: boolean;
  progress?: boolean;
  math?: boolean;
}

const routeLocale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const localeMeta = getLocaleMeta(routeLocale);
const altLocale = getAlternateLocale(routeLocale);
const altLocaleMeta = getLocaleMeta(altLocale);
const t = useTranslations(routeLocale);

const {
  title,
  description = site.descriptions[routeLocale],
  lang = localeMeta.htmlLang,
  type = 'website',
  image = routeLocale === 'en' ? '/og/en/_site.png' : '/og/_site.png',
  published,
  modified,
  tags = [],
  jsonLd,
  noindex = false,
  emitHreflang = true,
  progress = false,
  math = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.title}` : site.title;
const siteOrigin = Astro.site?.href ?? site.url;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const imageUrl = new URL(image, siteOrigin).href;
const alternates = getAlternateLinks(Astro.url.pathname, siteOrigin);
const shouldEmitHreflang = emitHreflang && !noindex;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      shouldEmitHreflang && (
        <>
          <link rel="alternate" hreflang="zh-CN" href={alternates.zh} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {shouldEmitHreflang && <meta property="og:locale:alternate" content={altLocaleMeta.ogLocale} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} (中文)`} href="/atom.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} (English)`} href="/en/atom.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={latinSerif} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1917" media="(prefers-color-scheme: dark)" />
    {math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css" crossorigin="anonymous" />}

    <!-- Apply the saved / system theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {
      site.adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    <Analytics />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"><span></span><span></span></div>
    <slot name="backdrop" />
    {progress && <div class="progress" aria-hidden="true"></div>}
    <a class="skip-link visually-hidden" href="#main">{t('a11y.skipToMain')}</a>
    <Header locale={routeLocale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={routeLocale} />
  </body>
</html>

<style>
  .skip-link:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip-path: none;
    padding: 0.4rem 0.8rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    z-index: 30;
  }
  main {
    min-height: 70vh;
  }
</style>
