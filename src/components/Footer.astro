---
import { site } from '../site.config';
import { getPosts } from '../lib/posts';

const year = new Date().getFullYear();
const since = (await getPosts()).at(-1)?.data.date.getUTCFullYear() ?? year;
---

<footer class="site-footer wrap">
  <span>© {since === year ? year : `${since}–${year}`} {site.author}</span>
  <span class="links">
    <a href="/atom.xml">RSS</a>
    {
      site.social.map(({ label, url }) => (
        <a href={url} rel="me">
          {label}
        </a>
      ))
    }
  </span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 5rem;
    padding-block: 1.6rem 2.4rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
</style>
