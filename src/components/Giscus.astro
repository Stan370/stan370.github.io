---
import { site } from '../site.config';
import { getLocaleFromPath, getLocaleMeta, stripLocalePrefix, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const giscusLang = getLocaleMeta(locale).giscusLang;
const canonicalPath = stripLocalePrefix(Astro.url.pathname);
const { repo, repoId, category, categoryId } = site.giscus;
const enabled = Boolean(repoId && categoryId);
---

{
  enabled && (
    <section class="comments" aria-label={t('a11y.comments')}>
      <div class="giscus" />
      <script is:inline define:vars={{ repo, repoId, category, categoryId, giscusLang, canonicalPath }}>
        const s = document.createElement('script');
        const dark = document.documentElement.dataset.theme === 'dark';
        Object.entries({
          repo,
          repoId,
          category,
          categoryId,
          mapping: 'specific',
          term: canonicalPath,
          strict: '0',
          reactionsEnabled: '1',
          emitMetadata: '0',
          inputPosition: 'top',
          lang: giscusLang,
          loading: 'lazy',
          theme: dark ? 'noborder_dark' : 'noborder_light',
        }).forEach(([k, v]) => (s.dataset[k] = v));
        s.src = 'https://giscus.app/client.js';
        s.crossOrigin = 'anonymous';
        s.async = true;
        document.currentScript.before(s);
      </script>
    </section>
  )
}

<style>
  .comments {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
