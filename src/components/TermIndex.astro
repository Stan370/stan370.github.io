---
import Base from '../layouts/Base.astro';
import WithSidebar from './WithSidebar.astro';
import { getPosts, taxonomy } from '../lib/posts';
import { getLocaleFromPath, localizePath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  kind: 'tags' | 'categories';
  locale?: Locale;
}

const { kind } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const label = kind === 'tags' ? t('terms.tags') : t('terms.categories');
const terms = taxonomy(await getPosts({ locale }), kind);
---

<Base locale={locale} title={label} description={t('terms.indexDescription', { label: label.toLowerCase() })}>
  <WithSidebar locale={locale}>
    <h1 class="page-title">{label}</h1>
    <ul class="term-list">
      {
        terms.map(([slug, { name, posts }]) => (
          <li>
            <a href={encodeURI(localizePath(`/${kind}/${slug}/`, locale))}>
              {kind === 'tags' ? `#${name}` : name}
              <sup>{posts.length}</sup>
            </a>
          </li>
        ))
      }
    </ul>
  </WithSidebar>
</Base>
