---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import WithSidebar from './WithSidebar.astro';
import { getLocaleFromPath, localizePath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import type { Post } from '../lib/posts';

interface Props {
  kind: 'tags' | 'categories';
  name: string;
  posts: Post[];
  locale?: Locale;
}

const { kind, name, posts } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const label = kind === 'tags' ? t('terms.tags') : t('terms.categories');
const heading = kind === 'tags' ? `#${name}` : name;
---

<Base
  locale={locale}
  title={t('terms.pageTitle', { label, name })}
  description={t('terms.pageDescription', { label: label.toLowerCase(), name, count: posts.length })}
>
  <WithSidebar locale={locale}>
    <h1 class="page-title">{heading}</h1>
    <p class="page-lede">
      {t('terms.count', { count: posts.length })} · <a href={localizePath(`/${kind}/`, locale)}>{t('terms.all', { label: label.toLowerCase() })}</a>
    </p>
    <PostList posts={posts} summaries locale={locale} />
  </WithSidebar>
</Base>
