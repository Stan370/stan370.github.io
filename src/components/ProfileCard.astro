---
import { blogStats, formatWords } from '../lib/activity';
import { formatDate, getPosts } from '../lib/posts';
import { site } from '../site.config';

const s = blogStats(await getPosts());
const stats = [
  { label: '文章', value: s.posts, href: '/archives/' },
  { label: '标签', value: s.tags, href: '/tags/' },
  { label: '分类', value: s.categories, href: '/categories/' },
];
const facts = [
  { label: '总字数', value: formatWords(s.words) },
  { label: '已写作', value: `${s.days.toLocaleString('zh-CN')} 天` },
  { label: '最近更新', value: formatDate(s.latest) },
];
---

<section class="profile-card" aria-label="关于博主">
  <a class="avatar" href="/about/" aria-label="关于">
    <img src={site.avatar} alt={site.author} width="88" height="88" loading="lazy" decoding="async" />
  </a>
  <p class="name">{site.author}</p>
  <p class="career">{site.career}</p>

  <dl class="stats">
    {
      stats.map(({ label, value, href }) => (
        <a href={href}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </a>
      ))
    }
  </dl>

  <dl class="facts">
    {
      facts.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd class="mono">{value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="actions">
    <a class="btn" href={`https://github.com/${site.githubUser}`} rel="me">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path></svg
      >
      GitHub
    </a>
    <a class="btn ghost" href="/atom.xml" aria-label="RSS 订阅">RSS</a>
  </div>
</section>

<style>
  .profile-card {
    position: relative;
    padding: 1.6rem 1.2rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(8px);
    text-align: center;
    font-family: var(--font-ui);
    overflow: hidden;
  }
  /* A thin vermilion-to-indigo wash along the top edge. */
  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--indigo));
    opacity: 0.8;
  }

  .avatar {
    position: relative;
    display: inline-block;
    padding: 3px;
    border-radius: 50%;
    background: conic-gradient(from var(--spin, 0deg), var(--accent), var(--indigo), var(--accent));
    animation: spin 12s linear infinite;
  }
  .avatar img {
    display: block;
    width: 88px;
    height: 88px;
    border: 3px solid var(--paper);
    border-radius: 50%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }
  .avatar:hover img {
    transform: rotate(-8deg) scale(1.04);
  }
  @property --spin {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes spin {
    to {
      --spin: 360deg;
    }
  }

  .name {
    margin: 0.7rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.3;
  }
  .career {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  dl {
    margin: 0;
  }
  dt {
    color: var(--muted);
    font-size: 0.72rem;
  }
  dd {
    margin: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1.1rem;
  }
  .stats a {
    padding: 0.3rem 0;
    border-radius: 8px;
    text-decoration: none;
  }
  .stats a:hover {
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }
  .stats dd {
    font-size: 1.3rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }

  .facts {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--rule);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .facts dd {
    font-size: 0.74rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .btn {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      background 150ms var(--ease),
      transform 150ms var(--ease);
  }
  .btn:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
  .btn.ghost {
    flex: 0 0 auto;
    background: none;
    color: var(--muted);
    border: 1px solid var(--rule);
  }
  .btn.ghost:hover {
    color: var(--accent);
    border-color: currentColor;
    background: none;
  }
</style>
