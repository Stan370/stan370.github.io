---
// Ink-wash (水墨) mountains, generated at build time from a fixed seed: inline SVG,
// no image requests. Mist and birds drift slowly; all motion stops under
// prefers-reduced-motion.
const W = 1440;
const H = 400;

function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Smooth closed ridge path through noisy points (Catmull-Rom → cubic Bézier). */
function ridge(seed: number, base: number, amp: number, step: number) {
  const r = rng(seed);
  const [f1, f2, f3] = [0.002 + r() * 0.002, 0.006 + r() * 0.004, 0.015 + r() * 0.01];
  const [p1, p2, p3] = [r() * 6.28, r() * 6.28, r() * 6.28];
  const pts: [number, number][] = [];
  for (let x = -step; x <= W + step; x += step) {
    const peak = 1 - Math.abs(Math.sin(x * f1 + p1)); // sharp-ish crests
    const y = base - amp * (0.6 * peak + 0.28 * Math.sin(x * f2 + p2) + 0.12 * Math.sin(x * f3 + p3));
    pts.push([x, Math.round(y * 10) / 10]);
  }
  let d = `M${pts[0][0]},${H} L${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1_, p2_, p3_] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    const c1 = [p1_[0] + (p2_[0] - p0[0]) / 6, p1_[1] + (p2_[1] - p0[1]) / 6];
    const c2 = [p2_[0] - (p3_[0] - p1_[0]) / 6, p2_[1] - (p3_[1] - p1_[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2_[0]},${p2_[1]}`;
  }
  return d + ` L${pts.at(-1)![0]},${H} Z`;
}

const layers = [
  { d: ridge(7, 300, 105, 36), top: 0.17, color: 'var(--indigo)' },
  { d: ridge(23, 330, 85, 30), top: 0.23, color: 'var(--ink)' },
  { d: ridge(41, 360, 62, 26), top: 0.3, color: 'var(--ink)' },
  { d: ridge(59, 392, 40, 22), top: 0.36, color: 'var(--ink)' },
];
---

<div class="ink-hero" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice">
    <defs>
      {
        layers.map((l, i) => (
          <linearGradient id={`ink${i}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style={`stop-color:${l.color};stop-opacity:${l.top}`} />
            <stop offset="0.55" style={`stop-color:${l.color};stop-opacity:${l.top * 0.45}`} />
            <stop offset="1" style={`stop-color:${l.color};stop-opacity:0`} />
          </linearGradient>
        ))
      }
      <radialGradient id="mist">
        <stop offset="0" style="stop-color:var(--paper);stop-opacity:0.95" />
        <stop offset="1" style="stop-color:var(--paper);stop-opacity:0" />
      </radialGradient>
      <radialGradient id="sun">
        <stop offset="0.62" style="stop-color:var(--accent);stop-opacity:0.9" />
        <stop offset="1" style="stop-color:var(--accent);stop-opacity:0" />
      </radialGradient>
    </defs>

    <circle class="sun" cx="250" cy="150" r="46" fill="url(#sun)"></circle>

    <path d={layers[0].d} fill="url(#ink0)"></path>
    <g class="mist m1"><ellipse cx="380" cy="290" rx="440" ry="36" fill="url(#mist)"></ellipse></g>
    <path d={layers[1].d} fill="url(#ink1)"></path>
    <g class="mist m2"><ellipse cx="1050" cy="330" rx="480" ry="32" fill="url(#mist)"></ellipse></g>
    <path d={layers[2].d} fill="url(#ink2)"></path>
    <g class="mist m3"><ellipse cx="620" cy="368" rx="540" ry="28" fill="url(#mist)"></ellipse></g>
    <path d={layers[3].d} fill="url(#ink3)"></path>

    <g class="birds" fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" opacity="0.55">
      <path d="M330,128 q6,-6 12,0 q6,-6 12,0"></path>
      <path d="M362,116 q4,-4 8,0 q4,-4 8,0"></path>
    </g>
  </svg>
</div>

<style>
  .ink-hero {
    position: absolute;
    inset: 0 0 auto;
    height: 440px;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Fade the bottom edge into the page so content sits on paper, not ink. */
    mask-image: linear-gradient(to bottom, #000 68%, transparent);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  [data-theme='dark'] .sun {
    opacity: 0.55;
  }

  .mist {
    animation: drift 34s ease-in-out infinite alternate;
  }
  .m2 {
    animation-duration: 46s;
    animation-direction: alternate-reverse;
  }
  .m3 {
    animation-duration: 58s;
  }
  .birds {
    animation: fly 70s linear infinite;
  }
  @keyframes drift {
    from {
      transform: translateX(-70px);
    }
    to {
      transform: translateX(70px);
    }
  }
  @keyframes fly {
    from {
      transform: translate(-200px, 16px);
    }
    to {
      transform: translate(360px, -24px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mist,
    .birds {
      animation: none;
    }
  }
</style>
