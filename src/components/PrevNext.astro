---
import { postHref, type Post } from '../lib/posts';
import { getLocaleFromPath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  older?: Post;
  newer?: Post;
  locale?: Locale;
}
const { older, newer } = Astro.props;
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

{
  (older || newer) && (
    <nav class="prev-next" aria-label={t('a11y.adjacentPosts')}>
      {older ? (
        <a href={postHref(older, locale)} rel="prev">
          <span class="label">{t('post.prev')}</span>
          <span class="title">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {newer && (
        <a class="next" href={postHref(newer, locale)} rel="next">
          <span class="label">{t('post.next')}</span>
          <span class="title">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  .next {
    text-align: right;
  }
  .label {
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }
  .title {
    font-size: 0.96em;
    line-height: 1.5;
  }
  a:hover .title {
    color: var(--accent);
  }
</style>
