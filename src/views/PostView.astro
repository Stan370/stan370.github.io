---
import { render } from 'astro:content';
import Post from '../layouts/Post.astro';
import PrevNext from '../components/PrevNext.astro';
import Giscus from '../components/Giscus.astro';
import {
  absoluteUrl,
  categoryHref,
  plainText,
  postHref,
  readingMinutes,
  summaryOf,
  type LocalizedPost,
  type Post as PostEntry,
} from '../lib/posts';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import { site } from '../site.config';

interface Props {
  locale: Locale;
  item: LocalizedPost;
  newer?: PostEntry;
  older?: PostEntry;
}

const { locale, item, newer, older } = Astro.props;
const { entry: post, meta } = item;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, date, updated, tags, categories } = post.data;

const text = plainText(post.body);
const description = summaryOf(post, 120);
const url = absoluteUrl(postHref(post, locale));
const image = encodeURI(locale === 'en' && meta.isTranslated ? `/og/en/${meta.baseId}.png` : `/og/${meta.baseId}.png`);

// SEO protection: prevent duplicate-content indexing when an /en/ post falls back to untranslated Chinese.
// Also only emit reciprocal hreflang tags when both locales have distinct content (translated pair).
const noindexFallback = locale === 'en' && meta.isFallback;
const hasBilingualPair = meta.isTranslated || meta.hasAlternateTranslation;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    inLanguage: meta.contentLang,
    keywords: tags.join(', ') || undefined,
    image: absoluteUrl(image),
    url,
    mainEntityOfPage: url,
    author: { '@type': 'Person', name: site.author, url: absoluteUrl(localizePath('/about/', locale)) },
    publisher: { '@type': 'Person', name: site.author },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.title, item: absoluteUrl(localizePath('/', locale)) },
      ...(categories[0]
        ? [{ '@type': 'ListItem', position: 2, name: categories[0], item: absoluteUrl(categoryHref(categories[0], locale)) }]
        : []),
      { '@type': 'ListItem', position: categories[0] ? 3 : 2, name: title, item: url },
    ],
  },
];
---

<Post
  locale={locale}
  title={title}
  description={description}
  contentLang={meta.contentLang}
  headings={headings}
  date={date}
  updated={updated}
  minutes={readingMinutes(text)}
  tags={tags}
  categories={categories}
  image={image}
  cover={post.data.img}
  math={Boolean(remarkPluginFrontmatter.hasMath)}
  noindex={noindexFallback}
  emitHreflang={hasBilingualPair && !noindexFallback}
  translationMeta={meta}
  jsonLd={jsonLd}
>
  <Content />
  <Fragment slot="after">
    <PrevNext older={older} newer={newer} locale={locale} />
    <Giscus locale={locale} />
  </Fragment>
</Post>
